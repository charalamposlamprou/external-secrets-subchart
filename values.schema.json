{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "external-secrets-subchart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Helm global values passed down by a parent chart.",
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^external-secrets\\.io/"
    },
    "pushSecretApiVersion": {
      "type": "string",
      "pattern": "^external-secrets\\.io/"
    },
    "namePrefix": {
      "type": "string"
    },
    "commonLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "commonAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refreshInterval": {
          "$ref": "#/definitions/duration"
        },
        "secretStoreRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/definitions/storeKind"
            }
          }
        },
        "target": {
          "type": "object"
        }
      }
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roleArn": {
          "$ref": "#/definitions/roleArn"
        },
        "region": {
          "type": "string"
        },
        "auth": {
          "description": "How ESO gets the app role: irsa (per-app ServiceAccount, default) or podIdentity (ESO controller's Pod Identity + AssumeRole with session tags; ESO >= 2.5.0).",
          "enum": [
            "",
            "irsa",
            "podIdentity"
          ]
        },
        "serviceAccountName": {
          "type": "string"
        },
        "serviceAccountAnnotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "parameterStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "refreshInterval": {
          "$ref": "#/definitions/duration"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "description": "One Kubernetes Secret: SECRET_KEY: name pairs plus optional fromPath.",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "refreshInterval": {
                "$ref": "#/definitions/duration"
              },
              "fromPath": {
                "type": "string",
                "minLength": 1,
                "description": "Take every parameter under this path."
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes Secret type, e.g. kubernetes.io/dockerconfigjson."
              },
              "template": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra keys built with ESO templates from the fetched keys (kept alongside them)."
              }
            },
            "patternProperties": {
              "^[-._a-zA-Z0-9]+$": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "secretsManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "refreshInterval": {
          "$ref": "#/definitions/duration"
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "description": "One Kubernetes Secret: SECRET_KEY: name pairs plus optional fromSecret.",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "refreshInterval": {
                "$ref": "#/definitions/duration"
              },
              "fromSecret": {
                "type": "string",
                "minLength": 1,
                "description": "Take every JSON field of this secret."
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "Kubernetes Secret type, e.g. kubernetes.io/dockerconfigjson."
              },
              "template": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra keys built with ESO templates from the fetched keys (kept alongside them)."
              }
            },
            "patternProperties": {
              "^[-._a-zA-Z0-9]+$": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "externalSecrets": {
      "allOf": [
        {
          "$ref": "#/definitions/feature"
        }
      ],
      "properties": {
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "namespace": {
                "type": "string"
              },
              "labels": {
                "$ref": "#/definitions/stringMap"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              },
              "source": {
                "$ref": "#/definitions/source"
              },
              "refreshInterval": {
                "$ref": "#/definitions/duration"
              },
              "refreshPolicy": {
                "enum": [
                  "CreatedOnce",
                  "Periodic",
                  "OnChange"
                ]
              },
              "secretStoreRef": {
                "$ref": "#/definitions/storeRef"
              },
              "target": {
                "type": "object"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "dataFrom": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "pushSecrets": {
      "allOf": [
        {
          "$ref": "#/definitions/feature"
        }
      ],
      "properties": {
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "namespace": {
                "type": "string"
              },
              "labels": {
                "$ref": "#/definitions/stringMap"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              },
              "source": {
                "$ref": "#/definitions/source"
              },
              "refreshInterval": {
                "$ref": "#/definitions/duration"
              },
              "updatePolicy": {
                "enum": [
                  "Replace",
                  "IfNotExists"
                ]
              },
              "deletionPolicy": {
                "enum": [
                  "Delete",
                  "None"
                ]
              },
              "secretStoreRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "$ref": "#/definitions/storeKind"
                    },
                    "labelSelector": {
                      "type": "object"
                    }
                  }
                }
              },
              "selector": {
                "type": "object"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "serviceAccounts": {
      "allOf": [
        {
          "$ref": "#/definitions/feature"
        }
      ],
      "properties": {
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "namespace": {
                "type": "string"
              },
              "labels": {
                "$ref": "#/definitions/stringMap"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              },
              "roleArn": {
                "$ref": "#/definitions/roleArn"
              }
            }
          }
        }
      }
    },
    "secretStores": {
      "allOf": [
        {
          "$ref": "#/definitions/feature"
        }
      ],
      "properties": {
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "namespace": {
                "type": "string"
              },
              "labels": {
                "$ref": "#/definitions/stringMap"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              },
              "provider": {
                "type": "object"
              },
              "extraSpec": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "clusterSecretStores": {
      "allOf": [
        {
          "$ref": "#/definitions/feature"
        }
      ],
      "properties": {
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "namespace": {
                "type": "string"
              },
              "labels": {
                "$ref": "#/definitions/stringMap"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              },
              "provider": {
                "type": "object"
              },
              "extraSpec": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "clusterExternalSecrets": {
      "allOf": [
        {
          "$ref": "#/definitions/feature"
        }
      ],
      "properties": {
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "labels": {
                "$ref": "#/definitions/stringMap"
              },
              "annotations": {
                "$ref": "#/definitions/stringMap"
              },
              "externalSecretName": {
                "type": "string"
              },
              "externalSecretSpec": {
                "type": "object",
                "properties": {
                  "secretStoreRef": {
                    "$ref": "#/definitions/storeRef"
                  }
                }
              },
              "namespaceSelectors": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "namespaces": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refreshTime": {
                "$ref": "#/definitions/duration"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "feature": {
      "description": "A feature block: off unless enabled, entries under items.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "object"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "duration": {
      "description": "Go duration string such as 1h or 30m; 0 disables refresh.",
      "type": [
        "string",
        "integer"
      ]
    },
    "roleArn": {
      "description": "IAM role ARN for IRSA, or a Helm template that renders one.",
      "type": "string",
      "pattern": "^(|arn:aws[a-z-]*:iam::[0-9]{12}:role/.+|.*\\{\\{.*)$"
    },
    "source": {
      "description": "AWS service to read from, through the aws block's store for it.",
      "enum": [
        "secretsManager",
        "parameterStore"
      ]
    },
    "storeKind": {
      "enum": [
        "SecretStore",
        "ClusterSecretStore"
      ]
    },
    "storeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/storeKind"
        }
      }
    },
    "remoteName": {
      "description": "Parameter/secret name, or {key, property, version}.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "property": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
