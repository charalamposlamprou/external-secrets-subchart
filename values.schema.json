  "definitions": {
    "feature": {
      "description": "A feature block: off unless enabled, entries under items.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "object"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "duration": {
      "description": "Go duration string such as 1h or 30m; 0 disables refresh.",
      "type": [
        "string",
        "integer"
      ]
    },
    "roleArn": {
      "description": "IAM role ARN for IRSA, or a Helm template that renders one.",
      "type": "string",
      "pattern": "^(|arn:aws[a-z-]*:iam::[0-9]{12}:role/.+|.*\\{\\{.*)$"
    },
    "source": {
      "description": "AWS service to read from, through the aws block's store for it.",
      "enum": [
        "secretsManager",
        "parameterStore"
      ]
    },
    "awsService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storeName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "storeKind": {
      "enum": [
        "SecretStore",
        "ClusterSecretStore"
      ]
    },
    "storeRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
